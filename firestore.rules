rules_version = '2';

// Security rules for The Flying Cocker members content.
//
// These run on Google's servers, not in the browser, so they cannot be
// bypassed by editing the page. They release the private `members` content
// ONLY to a signed-in user, and never allow writes from the website
// (you edit content in the Firebase console instead).
//
// Paste these into: Firebase console -> Firestore Database -> Rules -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Private members content: readable only when signed in; never writable
    // from the client.
    match /members/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else is locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
